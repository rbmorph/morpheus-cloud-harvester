resource "option-type" "provisionType.harvester.resourcePool" {
  category         = "provisionType.harvester"
  code             = "provisionType.harvester.resourcePool"
  displayOrder     = 1
  fieldCode        = "gomorpheus.optiontype.ResourcePool"
  fieldContext     = "config"
  fieldGroup       = "Options"
  fieldLabel       = "Resource Pool"
  fieldName        = "harvesterResourcePoolId"
  name             = "resource pool"
  type             = "select"
  required         = true
  enabled          = true
  optionSource     = "zonePools"
  editable         = false
  global           = false
  placeHolder      = null
  helpBlock        = ""
  defaultValue     = null
  custom           = false
  fieldClass       = null
  noBlank          = true
  contextualDefault = true
}

resource "provision-type" "harvester" {
    code                  = "harvester-provision-provider-plugin"
    name                  = "Harvester"
    isPlugin              = true
    serverType            = "vm"
    managed               = true
    hostType              = "vm"
    nodeFormat            = "vm"
    cloneable             = false
    enabled               = true
    hasVolumes            = true
    addVolumes            = true
    hasDatastore          = true
    provisionService      = "cloudPluginProvisioningService"
    deployTargetService   = "vmDeployTargetService"
    minDisk               = 0
    customizeVolume       = true
    rootDiskCustomizable  = true
    rootDiskSizeKnown     = true
    rootDiskResizable     = true
    hasResourcePools      = true
    requiresResourcePool  = true
    hasZonePools          = true
    zonePoolRequired      = true
    hasNetworks           = true
    networksScopedToPools = true
    supportsAutoDatastore = true
    hasSnapshots          = true
    // Cores per socket is chosen with the core count; Harvester gets cores (per socket) and sockets
    hasConfigurableCpuSockets = true
    // The namespace is the selected resource pool, so there is no separate project field
    optionTypes = [
        { code = "provisionType.harvester.image" },
        { code = "provisionType.harvester.skipNetworkWait" },
        { code = "provisionType.harvester.cpuMemoryHotAdd" }
    ]
    virtualImageTypes = [
        { code = "raw" },
        { code = "qcow2" },
        { code = "iso" }
    ]
    rootStorageTypes = [
        { code = "harvesterPVC" }
    ]
    storageTypes = [
        { code = "harvesterPVC" }
    ]
    controllerTypes = [
        { code = "harvester-virtio" },
        { code = "harvester-scsi" }
    ]

}

resource "compute-type" "harvesterVM" {
    code              = "harvester-vm"
    name              = "Harvester VM"
    hostType          = "harvesterVM"
    isPlugin          = true
    isEmbedded        = false
}

resource "compute-server-type" "harvesterUnmanaged" {
    code                = "harvesterUnmanaged"
    name                = "Harvester Instance"
    description         = "harvester vm"
    platform            = "linux"
    nodeType            = "unmanaged"
    isPlugin            = true
    enabled             = true
    selectable          = false
    externalDelete      = false
    managed             = false
    supportsConsoleKeymap = true
    controlPower        = true
    controlSuspend      = false
    creatable           = false
    computeService      = "cloudPluginComputeService"
    deleteQueue         = "computeHarvesterDeleteServerQueue"
    initializeQueue     = "computeHarvesterInitializeServerQueue"
    displayOrder        = 99
    hasAutomation       = false
    hasAgent            = true
    containerHypervisor = false
    bareMetalHost       = false
    vmHypervisor        = false
    agentType           = "vm"
    managedServerType   = "harvester-linux"
    guestVm             = true
    provisionType = {
        code = "harvester-provision-provider-plugin"
    }
    computeType = {
            code = "harvester-vm"
    }
    optionTypes = [
        { code = "computeServerType.global.sshHost" },
        { code = "computeServerType.global.sshPort" },
        { code = "computeServerType.global.sshUsername" },
        { code = "computeServerType.global.sshPassword" }
    ]
}


