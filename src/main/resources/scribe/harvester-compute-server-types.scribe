    name              = "Harvester Master"
    hostType          = "harvesterMaster"
    isPlugin          = true
    isEmbedded        = false
}

resource "compute-type" "harvesterWorker" {
    code              = "harvester-worker"
    name              = "Harvester Worker"
    hostType          = "harvesterWorker"
    isPlugin          = true
    isEmbedded        = false
}

resource "compute-server-type" "harvesterMaster" {
    // Harvester hosts are VM hypervisors: not managed, no agent, no Kubernetes view
    code                = "harvesterMaster"
    isPlugin            = true
    name                = "Harvester Master"
    description         = "Harvester hypervisor host"
    platform            = "linux"
    nodeType            = "harvester-master"
    hasMaintenanceMode  = false
    reconfigureSupported = false
    enabled             = true
    selectable          = false
    externalDelete      = false
    managed             = false
    controlPower        = false
    controlSuspend      = false
    creatable           = false
    computeService      = "cloudPluginComputeService"
    displayOrder        = 10
    hasAutomation       = false
    hasAgent            = false
    containerHypervisor = false
    bareMetalHost       = false
    vmHypervisor        = true
    agentType           = "none"
    provisionType = {
        code = "harvester-provision-provider-plugin"
    }
    computeType = {
        code = "harvester-master"
    }
    optionTypes = []
}

